{
  "name": "ui-test-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Copilot-driven UI testing with Markdown plans and reviewable evidence.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "project:new": "node scripts/workspace.mjs project",
    "run:new": "node scripts/workspace.mjs run",
    "browser": "playwright cli",
    "browser:install": "playwright install chromium",
    "demo": "node scripts/demo.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --test tests/workspace.test.mjs",
    "check": "tsc --noEmit && node --check scripts/workspace.mjs && node --check scripts/demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
